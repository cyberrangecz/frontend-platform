{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "../../../../dist/out-tsc",
        "types": [],
        "strict": false,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0"
    },
    "files": ["main.ts"],
    "include": ["**/*.d.ts", "**/*.ts"],
    "angularCompilerOptions": {
        "extendedDiagnostics": {
            "checks": {
                "nullishCoalescingNotNullable": "suppress",
                "optionalChainNotNullable": "suppress"
            }
        }
    }
}
