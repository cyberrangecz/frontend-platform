{
    "name": "cyberrangecz-platform",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/cyberrangecz-platform/src",
    "tags": [],
    "implicitDependencies": ["theme"],
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:application",
            "outputs": ["{options.outputPath}"],
            "dependsOn": ["theme:build"],
            "options": {
                "outputPath": "dist/apps/cyberrangecz-platform",
                "index": "apps/cyberrangecz-platform/src/index.html",
                "browser": "apps/cyberrangecz-platform/src/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "apps/cyberrangecz-platform/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/cyberrangecz-platform/public",
                        "output": "./assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "dist/libs/utils/theme/assets/",
                        "output": "/assets/"
                    },
                    {
                        "glob": "pglite.wasm",
                        "input": "node_modules/@electric-sql/pglite/dist",
                        "output": "/"
                    },
                    {
                        "glob": "initdb.wasm",
                        "input": "node_modules/@electric-sql/pglite/dist",
                        "output": "/"
                    }
                ],
                "styles": ["dist/libs/utils/theme/theme/apply-all.scss"],
                "scripts": [],
                "webWorkerTsConfig": "apps/cyberrangecz-platform/tsconfig.worker.json"
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "1500kb",
                            "maximumError": "3mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "fileReplacements": [
                        {
                            "replace": "apps/cyberrangecz-platform/src/environments/environment.ts",
                            "with": "apps/cyberrangecz-platform/src/environments/environment.development.ts"
                        }
                    ]
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "dependsOn": ["theme:build"],
            "executor": "@angular-devkit/build-angular:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "cyberrangecz-platform:build:production"
                },
                "development": {
                    "buildTarget": "cyberrangecz-platform:build:development",
                    "ssl": true
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "buildTarget": "cyberrangecz-platform:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@nx/vite:test",
            "outputs": ["{options.reportsDirectory}"],
            "options": {
                "reportsDirectory": "../../coverage/apps/cyberrangecz-platform",
                "webWorkerTsConfig": "apps/cyberrangecz-platform/tsconfig.worker.json"
            }
        },
        "serve-static": {
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "cyberrangecz-platform:build",
                "port": 4200,
                "staticFilePath": "dist/apps/cyberrangecz-platform/browser",
                "spa": true
            }
        },
        "build-e2e": {
            "executor": "@angular-devkit/build-angular:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/cyberrangecz-platform-e2e",
                "index": "apps/cyberrangecz-platform/e2e/harness/index.html",
                "browser": "apps/cyberrangecz-platform/e2e/harness/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "apps/cyberrangecz-platform/e2e/harness/tsconfig.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    {
                        "glob": "pglite.wasm",
                        "input": "node_modules/@electric-sql/pglite/dist",
                        "output": "/"
                    },
                    {
                        "glob": "initdb.wasm",
                        "input": "node_modules/@electric-sql/pglite/dist",
                        "output": "/"
                    }
                ],
                "styles": [],
                "scripts": [],
                "webWorkerTsConfig": "apps/cyberrangecz-platform/tsconfig.worker.json"
            },
            "configurations": {
                "production": {
                    "optimization": true,
                    "outputHashing": "none"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "development"
        },
        "serve-e2e": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "options": {
                "port": 4200,
                "host": "localhost",
                "ssl": true
            },
            "configurations": {
                "production": {
                    "buildTarget": "cyberrangecz-platform:build-e2e:production"
                },
                "development": {
                    "buildTarget": "cyberrangecz-platform:build-e2e:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "e2e": {
            "executor": "@nx/playwright:playwright",
            "outputs": ["{workspaceRoot}/dist/.playwright/apps/cyberrangecz-platform"],
            "options": {
                "config": "apps/cyberrangecz-platform/e2e/playwright.config.ts"
            }
        }
    }
}
